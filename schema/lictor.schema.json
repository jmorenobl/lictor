{
  "$defs": {
    "AcceptanceConfig": {
      "additionalProperties": false,
      "description": "Configuración de la suite de aceptación (L3) que decide el proyecto.",
      "properties": {
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        },
        "timeout_s": {
          "default": 600,
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "integer"
        },
        "failure_exit_codes": {
          "default": [
            1
          ],
          "items": {
            "type": "integer"
          },
          "minItems": 1,
          "title": "Failure Exit Codes",
          "type": "array"
        },
        "driver_hints": {
          "default": "",
          "title": "Driver Hints",
          "type": "string"
        }
      },
      "required": [
        "run"
      ],
      "title": "AcceptanceConfig",
      "type": "object"
    },
    "ApiConfig": {
      "additionalProperties": false,
      "description": "What the person accepts to break of the public API that existed (ADR-0017).\n\nQualified names, as the report names them: a break of one of them, or of a name under it, is\ntold apart and doesn't fail the control.",
      "properties": {
        "accepted": {
          "items": {
            "type": "string"
          },
          "title": "Accepted",
          "type": "array"
        },
        "base": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Base"
        }
      },
      "title": "ApiConfig",
      "type": "object"
    },
    "BackendConfig": {
      "additionalProperties": false,
      "description": "Configuración del backend de agente.",
      "properties": {
        "kind": {
          "default": "claude-cli",
          "enum": [
            "claude-cli",
            "fake"
          ],
          "title": "Kind",
          "type": "string"
        },
        "model": {
          "default": "claude-sonnet-5-5",
          "title": "Model",
          "type": "string"
        },
        "auth": {
          "default": "subscription",
          "enum": [
            "subscription",
            "api_key"
          ],
          "title": "Auth",
          "type": "string"
        },
        "max_turns": {
          "default": 40,
          "exclusiveMinimum": 0,
          "title": "Max Turns",
          "type": "integer"
        },
        "timeout_s": {
          "default": 1800,
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "integer"
        }
      },
      "title": "BackendConfig",
      "type": "object"
    },
    "BlindSpotsConfig": {
      "additionalProperties": false,
      "description": "What the person accepts that no control sees, only counted: paths, and «file: command»\nfor a step of the CI.",
      "properties": {
        "accepted": {
          "items": {
            "type": "string"
          },
          "title": "Accepted",
          "type": "array"
        }
      },
      "title": "BlindSpotsConfig",
      "type": "object"
    },
    "ControlChange": {
      "additionalProperties": false,
      "description": "Un control escrito en lictor.json: cambia, quita o añade uno sobre los del perfil.\n\nCon el `id` de un control del perfil, cambia solo los campos escritos, y `enabled: false` lo\nquita. Con otro `id`, añade un control: uno que ejecuta necesita `level`, `report` y `run`, y\nuno que lee la ejecución de otro, `level`, `report: \"coverage\"`, `reads` y `adds`. `run`,\n`reads` y `adds` se escriben o no, pero nunca con null.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        },
        "level": {
          "enum": [
            "L1",
            "L2",
            "L4",
            "L5"
          ],
          "title": "Level",
          "type": "string"
        },
        "run": {
          "minLength": 1,
          "title": "Run",
          "type": "string"
        },
        "reads": {
          "description": "El id del control, con report junit, cuya ejecución lee este control.",
          "minLength": 1,
          "title": "Reads",
          "type": "string"
        },
        "adds": {
          "description": "Los argumentos que el control que nombra reads recibe al final de su comando, con el {out} de este control. Se escribe entero: lo que no escribas no se añade, así que conserva lo que el perfil pone (por ejemplo, el argumento que anula el umbral propio de la herramienta).",
          "minLength": 1,
          "title": "Adds",
          "type": "string"
        },
        "report": {
          "enum": [
            "exit-code",
            "junit",
            "mutation",
            "coverage",
            "complexity",
            "duplication",
            "api"
          ],
          "title": "Report",
          "type": "string"
        },
        "mode": {
          "enum": [
            "block",
            "measure"
          ],
          "title": "Mode",
          "type": "string"
        },
        "stage": {
          "enum": [
            "attempt",
            "check"
          ],
          "title": "Stage",
          "type": "string"
        },
        "empty_exit_codes": {
          "items": {
            "type": "integer"
          },
          "title": "Empty Exit Codes",
          "type": "array"
        },
        "timeout_s": {
          "exclusiveMinimum": 0,
          "title": "Timeout S",
          "type": "integer"
        },
        "when_exists": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When Exists"
        },
        "when_plugin": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "When Plugin"
        },
        "min_score": {
          "anyOf": [
            {
              "maximum": 100,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min Score"
        },
        "agent_run": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "La orden con la que el agente comprueba o mide este control por su cuenta, tal como la ejecutaría. Sin ella, el agente comprueba un control que bloquea con su run sin el informe. Con min_score, el prompt le dice el mínimo y esta orden. La verificación nunca la ejecuta, y tiene que estar permitida por agent_tools. Quien cambia run la escribe también, o null.",
          "title": "Agent Run"
        },
        "agent_fix": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "La orden con la que el agente deja hecho lo que este control comprueba (un formateador), que se le da solo mientras el control bloquea en cada intento. La verificación nunca la ejecuta, y tiene que estar permitida por agent_tools. Quien cambia run la escribe también, o null.",
          "title": "Agent Fix"
        },
        "limit": {
          "anyOf": [
            {
              "exclusiveMinimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "La complejidad ciclomática que ninguna función puede superar; solo, y siempre, con report='complexity' (ADR-0013).",
          "title": "Limit"
        }
      },
      "required": [
        "id"
      ],
      "title": "ControlChange",
      "type": "object"
    },
    "ConventionsConfig": {
      "additionalProperties": false,
      "description": "The project's rules of code, which the agents get (F79), and the rule files they came from.\n\n`reviewed` is the hash of each rule file's content as the person read it, written by\n`lictor conventions --reviewed`: only `doctor` reads it, so it stays out of the fingerprint.",
      "properties": {
        "text": {
          "default": "",
          "title": "Text",
          "type": "string"
        },
        "reviewed": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Reviewed",
          "type": "object"
        }
      },
      "title": "ConventionsConfig",
      "type": "object"
    },
    "LimitsConfig": {
      "additionalProperties": false,
      "description": "Límites de intentos y tamaño de error.",
      "properties": {
        "max_attempts": {
          "default": 3,
          "exclusiveMinimum": 0,
          "title": "Max Attempts",
          "type": "integer"
        },
        "max_driver_attempts": {
          "default": 2,
          "exclusiveMinimum": 0,
          "title": "Max Driver Attempts",
          "type": "integer"
        },
        "error_max_chars": {
          "default": 4000,
          "minimum": 500,
          "title": "Error Max Chars",
          "type": "integer"
        }
      },
      "title": "LimitsConfig",
      "type": "object"
    },
    "PathsConfig": {
      "additionalProperties": false,
      "description": "Rutas escribibles, del driver y protegidas del proyecto.",
      "properties": {
        "writable": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Writable",
          "type": "array"
        },
        "driver": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Driver",
          "type": "array"
        },
        "protected": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Protected",
          "type": "array"
        }
      },
      "required": [
        "writable",
        "driver",
        "protected"
      ],
      "title": "PathsConfig",
      "type": "object"
    },
    "ProjectVerification": {
      "additionalProperties": false,
      "description": "Lo que un proyecto añade a la verificación de su perfil, sin poder quitarle nada.\n\n`prepare` solo cuando el perfil no construye el entorno (ADR-0020): entonces lo construye el\nproyecto, con su hash.",
      "properties": {
        "prepare": {
          "default": "",
          "title": "Prepare",
          "type": "string"
        },
        "env": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Env",
          "type": "object"
        },
        "inherit": {
          "items": {
            "type": "string"
          },
          "title": "Inherit",
          "type": "array"
        },
        "prepare_inherit": {
          "items": {
            "type": "string"
          },
          "title": "Prepare Inherit",
          "type": "array"
        }
      },
      "title": "ProjectVerification",
      "type": "object"
    },
    "RefactorConfig": {
      "additionalProperties": false,
      "description": "El paso de refactor tras cada escenario implementado (ADR-0010).",
      "properties": {
        "enabled": {
          "default": true,
          "title": "Enabled",
          "type": "boolean"
        }
      },
      "title": "RefactorConfig",
      "type": "object"
    },
    "RetentionConfig": {
      "additionalProperties": false,
      "description": "Cuánta evidencia de ejecuciones anteriores se conserva en .lictor/runs/.",
      "properties": {
        "keep_runs": {
          "default": 10,
          "minimum": 1,
          "title": "Keep Runs",
          "type": "integer"
        },
        "keep_retired": {
          "default": 10,
          "minimum": 1,
          "title": "Keep Retired",
          "type": "integer"
        }
      },
      "title": "RetentionConfig",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "lictor.json tal como lo escribe la persona: lo que no escribe sale del perfil al cargar.\n\nUna clave escrita sustituye entera la del perfil, salvo `controls`, que son cambios por `id`\nsobre los del perfil (`ControlChange`).",
  "properties": {
    "suppressions": {
      "items": {
        "type": "string"
      },
      "title": "Suppressions",
      "type": "array"
    },
    "banned_patterns": {
      "items": {
        "type": "string"
      },
      "title": "Banned Patterns",
      "type": "array"
    },
    "forbidden_paths": {
      "items": {
        "type": "string"
      },
      "title": "Forbidden Paths",
      "type": "array"
    },
    "code_paths": {
      "items": {
        "type": "string"
      },
      "title": "Code Paths",
      "type": "array"
    },
    "code_exclude": {
      "items": {
        "type": "string"
      },
      "title": "Code Exclude",
      "type": "array"
    },
    "version": {
      "default": "0.1",
      "title": "Version",
      "type": "string"
    },
    "profile": {
      "minLength": 1,
      "title": "Profile",
      "type": "string"
    },
    "backend": {
      "$ref": "#/$defs/BackendConfig"
    },
    "limits": {
      "$ref": "#/$defs/LimitsConfig"
    },
    "retention": {
      "$ref": "#/$defs/RetentionConfig"
    },
    "refactor": {
      "$ref": "#/$defs/RefactorConfig"
    },
    "blind_spots": {
      "$ref": "#/$defs/BlindSpotsConfig"
    },
    "conventions": {
      "$ref": "#/$defs/ConventionsConfig"
    },
    "api": {
      "$ref": "#/$defs/ApiConfig"
    },
    "paths": {
      "anyOf": [
        {
          "$ref": "#/$defs/PathsConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "acceptance": {
      "anyOf": [
        {
          "$ref": "#/$defs/AcceptanceConfig"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "controls": {
      "items": {
        "$ref": "#/$defs/ControlChange"
      },
      "title": "Controls",
      "type": "array"
    },
    "verification": {
      "$ref": "#/$defs/ProjectVerification"
    },
    "agent_tools": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Agent Tools"
    },
    "hints": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Hints"
    },
    "gitignore": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Gitignore"
    }
  },
  "required": [
    "profile"
  ],
  "title": "LictorFile",
  "type": "object"
}
