{
  "name": "python-uv",
  "version": "0.1",
  "status": "stable",
  "detect": ["pyproject.toml"],
  "paths": {
    "writable": ["src/", "tests/unit/"],
    "driver": ["tests/acceptance/"],
    "protected": ["features/", "tests/acceptance/", "lictor.json", "pyproject.toml", "uv.lock"]
  },
  "acceptance": {
    "run": "uv run pytest tests/acceptance -q --junitxml {out}",
    "report": "junit",
    "failure_exit_codes": [1],
    "driver_hints": "Usa pytest-bdd. Escribe los tests y todas las definiciones de pasos (@given, @when, @then) juntos en tests/acceptance/test_<nombre>.py (o en tests/acceptance/conftest.py) para que pytest los encuentre. Un test por escenario, enlazado con @scenario('../../features/<archivo>.feature', '<nombre>') y llamado test_<id> (por ejemplo test_iva_001). Los pasos @given que devuelvan una entidad deben usar target_fixture='<nombre_fixture>'. Los pasos deben llamar a la interfaz pública en src/ para que fallen por NotImplementedError al ejecutarse con pytest. Crea en src/ la interfaz pública mínima requerida por los pasos, con funciones que lancen NotImplementedError y código limpio que pase lint (por ejemplo, en clases con docstring no agregues 'pass' innecesario)."
  },
  "controls": [
    {"id": "lint",  "level": "L1", "run": "uv run ruff check src", "report": "exit-code", "mode": "block"},
    {"id": "types", "level": "L1", "run": "uv run mypy src", "report": "exit-code", "mode": "block"},
    {"id": "unit",  "level": "L2", "run": "uv run pytest tests/unit -q --junitxml {out}", "report": "junit", "mode": "block", "allow_empty": true}
  ],
  "suppressions": ["# noqa", "# type: ignore", "# pragma: no cover"],
  "banned_patterns": [
    "#\\s*noqa",
    "#\\s*type:\\s*ignore",
    "#\\s*pragma:\\s*no\\s*cover",
    "#\\s*(ruff|flake8):\\s*noqa",
    "#\\s*mypy:\\s*ignore-errors",
    "pytest\\.(skip|xfail)\\(",
    "pytest\\.mark\\.(skip|skipif|xfail)\\b"
  ],
  "forbidden_paths": [
    "*.dist-info", "*.egg-info", "*.pth", ".gitignore", ".gitattributes", "conftest.py",
    "pytest.ini", ".pytest.ini", "tox.ini", "setup.cfg", "pyproject.toml",
    "ruff.toml", ".ruff.toml", "mypy.ini", ".mypy.ini", "sitecustomize.py", "usercustomize.py"
  ],
  "verification": {
    "prepare": "uv sync --frozen --no-install-project",
    "env": {
      "UV_PROJECT_ENVIRONMENT": "{env_dir}",
      "UV_LINK_MODE": "copy",
      "UV_NO_SYNC": "1",
      "UV_FROZEN": "1",
      "PYTHONDONTWRITEBYTECODE": "1",
      "PYTHONNOUSERSITE": "1",
      "UV_NO_ENV_FILE": "1",
      "PYTEST_ADDOPTS": "-o pythonpath=",
      "PYTEST_DISABLE_PLUGIN_AUTOLOAD": "1"
    },
    "plugin_variable": "PYTEST_PLUGINS",
    "plugins": ["lictor_project_path"],
    "inherit": [
      "PATH", "HOME", "TMPDIR", "XDG_CACHE_HOME", "XDG_DATA_HOME",
      "UV_CACHE_DIR", "UV_PYTHON_INSTALL_DIR",
      "HTTP_PROXY", "HTTPS_PROXY", "ALL_PROXY", "NO_PROXY",
      "http_proxy", "https_proxy", "all_proxy", "no_proxy",
      "SSL_CERT_FILE", "SSL_CERT_DIR", "UV_SYSTEM_CERTS", "REQUESTS_CA_BUNDLE"
    ],
    "reserved": [
      "PYTHON*", "PYTEST*", "UV_*", "VIRTUAL_ENV", "COV_CORE_*", "COVERAGE_*", "MYPY*", "RUFF_*",
      "LD_*", "DYLD_*", "BASH_ENV", "ENV"
    ],
    "files_dir_command": "{env_dir}/bin/python -I -B -c 'import sysconfig; print(sysconfig.get_path(\"purelib\"))'",
    "files": ["python_uv/lictor_project_path.py"]
  },
  "agent_tools": ["Bash(uv run pytest:*)", "Bash(uv run ruff:*)", "Bash(uv run mypy:*)"],
  "agent_commands": ["uv run ruff check src", "uv run mypy src", "uv run pytest tests/unit -q", "uv run pytest tests/acceptance -q"],
  "hints": "Python 3.12, gestor uv, tests con pytest. El código va en src/<paquete>/.",
  "init_note": "pytest corre sin autoload de plugins: declara los del proyecto en verification.plugins de lictor.json, por ejemplo pytest_bdd.plugin si el driver usa pytest-bdd.",
  "gitignore": ["__pycache__/", "*.pyc", ".venv/", ".pytest_cache/", ".mypy_cache/", ".ruff_cache/"]
}
