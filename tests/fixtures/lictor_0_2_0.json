{
  "version": "0.1",
  "profile": "python-uv@0.1",
  "backend": {
    "kind": "claude-cli",
    "model": "claude-sonnet-5-5",
    "auth": "subscription",
    "max_turns": 40,
    "timeout_s": 1800
  },
  "limits": {
    "max_attempts": 3,
    "max_driver_attempts": 2,
    "error_max_chars": 4000
  },
  "retention": {
    "keep_runs": 10
  },
  "paths": {
    "writable": [
      "src/",
      "tests/unit/"
    ],
    "driver": [
      "tests/acceptance/"
    ],
    "protected": [
      "features/",
      "tests/acceptance/",
      "lictor.json",
      "pyproject.toml",
      "uv.lock"
    ]
  },
  "acceptance": {
    "run": "uv run pytest tests/acceptance -q --junitxml {out}",
    "report": "junit",
    "timeout_s": 600,
    "failure_exit_codes": [
      1
    ]
  },
  "controls": [
    {
      "id": "lint",
      "level": "L1",
      "run": "uv run ruff check src",
      "report": "exit-code",
      "mode": "block",
      "empty_exit_codes": [],
      "timeout_s": 600,
      "when_exists": null,
      "when_plugin": null,
      "min_score": null
    },
    {
      "id": "types",
      "level": "L1",
      "run": "uv run mypy src",
      "report": "exit-code",
      "mode": "block",
      "empty_exit_codes": [],
      "timeout_s": 600,
      "when_exists": null,
      "when_plugin": null,
      "min_score": null
    },
    {
      "id": "unit",
      "level": "L2",
      "run": "uv run pytest tests/unit -q --junitxml {out}",
      "report": "junit",
      "mode": "block",
      "empty_exit_codes": [
        5
      ],
      "timeout_s": 600,
      "when_exists": "tests/unit",
      "when_plugin": null,
      "min_score": null
    },
    {
      "id": "coverage",
      "level": "L2",
      "run": "uv run pytest tests/unit -q --cov=src --cov-branch --cov-report=term",
      "report": "exit-code",
      "mode": "measure",
      "empty_exit_codes": [
        5
      ],
      "timeout_s": 600,
      "when_exists": "tests/unit",
      "when_plugin": "pytest_cov.plugin",
      "min_score": null
    }
  ],
  "verification": {
    "env": {},
    "inherit": [],
    "prepare_inherit": []
  },
  "agent_tools": [
    "Bash(uv run pytest:*)",
    "Bash(uv run ruff:*)",
    "Bash(uv run mypy:*)"
  ],
  "agent_commands": [
    "uv run ruff check src",
    "uv run mypy src",
    "uv run pytest tests/unit -q",
    "uv run pytest tests/acceptance -q"
  ],
  "hints": "Python >=3.12, gestor uv, tests con pytest. El código va en src/<paquete>/.",
  "gitignore": [
    "__pycache__/",
    "*.pyc",
    ".venv/",
    ".pytest_cache/",
    ".mypy_cache/",
    ".ruff_cache/"
  ]
}
